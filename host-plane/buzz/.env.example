# Buzz relay env — production-shape defaults for host-plane v0 (#47).
# Copy to ~/.buzz/.env on grr-remote-dev-01 (mode 0600) and fill operator-tunable
# values. Random secrets below are placeholders; scripts/install-buzz.sh
# generates fresh ones on first run and rewrites them in place.
#
# Image: defaults to :main (early-testing channel per upstream). For production
# pin to :sha-<7> (immutable rolling tag). `relay-v*` tags are referenced in
# research/buzz-selfhost.md but are NOT yet published to GHCR as of writing.

BUZZ_IMAGE=ghcr.io/block/buzz:main

# --- Loopback bind (default) ----------------------------------------------------
# v0 is loopback-only — Hermes (the agent) reaches the relay at ws://127.0.0.1:3000
# from inside the same host; operator reaches it from the laptop over Tailscale
# or an SSH tunnel. No public hostname yet. See servers/grr-buzz.md for the
# cloudflared-fronted path when that's wanted.
BUZZ_HTTP_PORT=3000

# --- Relay identity -------------------------------------------------------------
# BUZZ_RELAY_PRIVATE_KEY is the relay's Nostr keypair (secp256k1, 64-char hex
# with optional `nsec1` bech32 prefix accepted by the relay). It signs relay-
# emitted events (e.g. kind 5 deletions, channel metadata). Losing this key
# breaks verification of every past relay-signed event. Back up before anything
# else. Stays on the VPS in ~/.buzz/.env; it is NOT a Hermes secret.
BUZZ_RELAY_PRIVATE_KEY=REPLACE_ME_64_HEX_OR_NSEC_BECH32

# Owner / operator pubkey (64-char hex, no npub). Marked as the workspace owner
# in NIP-11 / NIP-42. For v0 single-operator this is the operator's Nostr key
# (NOT Hermes's key — Hermes is a Bot). Use `nak pubkey <operator-nsec>` to get
# the hex form.
RELAY_OWNER_PUBKEY=REPLACE_ME_OWNER_PUBKEY_HEX

# Optional operator roster (comma-separated hex). Same role as RELAY_OWNER_PUBKEY
# but multiple. Leave empty for v0 single-operator.
# RELAY_OPERATOR_PUBKEYS=

# --- Stable secrets (generated by install-buzz.sh on first run) -----------------
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=REPLACE_ME_RANDOM
REDIS_PASSWORD=REPLACE_ME_RANDOM
BUZZ_S3_ACCESS_KEY=REPLACE_ME_RANDOM
BUZZ_S3_SECRET_KEY=REPLACE_ME_RANDOM
BUZZ_S3_BUCKET=buzz-media
BUZZ_GIT_HOOK_HMAC_SECRET=REPLACE_ME_RANDOM_64_HEX

# --- Relay policy ----------------------------------------------------------------
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# --- Optional admin dashboard ----------------------------------------------------
# Off for v0. Hermes is a Bot, not an admin; operator drives room creation and
# membership via the Buzz desktop client (or `buzz-admin add-member` from the
# relay container). Enable when a web moderation surface is actually needed.
# BUZZ_ADMIN_HOST=admin.buzz.example.com
# BUZZ_ADMIN_AUTH=nip98
# RELAY_OPERATOR_API_ORIGIN=https://admin.buzz.example.com

# --- Hermes-side wiring (NOT relay-side; written here only for reference) ------
# These belong in ~/.hermes/.env on grr (managed by scripts/unwrap-hermes-env.sh
# from the laptop pass tree; see ADR #0010). They are listed here so a single
# grep over `~/.buzz/.env` makes the wiring obvious during smoke tests.
#
#   BUZZ_RELAY_URL=ws://127.0.0.1:3000
#   BUZZ_PRIVATE_KEY=nsec1...                       # Hermes keypair (ADR #0010)
#   BUZZ_HOME_CHANNEL=<uuid>                        # the one demo room (#43)
#   BUZZ_CHANNELS=[<uuid>]
#   BUZZ_ALLOWED_USERS=[<operator-hex-pubkey>]
#   BUZZ_TRANSPORT=auto                              # in-process relay client
# Project-container base. Decisions: GitHub issues #8 (tools) and #9 (GHCR).
# Node/Python are per-project via mise — not baked in. nvim stays on the host plane.
FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04

LABEL org.opencontainers.image.source="https://github.com/dvogeldev/remote-dev" \
      org.opencontainers.image.description="Ubuntu 24.04 project-container base: CLI tools + mise; languages per project" \
      org.opencontainers.image.licenses="MIT"

USER root
ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bat \
        build-essential \
        ca-certificates \
        curl \
        extrepo \
        fd-find \
        fzf \
        git \
        gnupg \
        ripgrep \
        tldr; \
    ln -sfn /usr/bin/batcat /usr/local/bin/bat; \
    ln -sfn /usr/bin/fdfind /usr/local/bin/fd; \
    extrepo enable mise; \
    apt-get update; \
    apt-get install -y --no-install-recommends mise; \
    apt-get remove -y --auto-remove extrepo; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://deb.griffo.io/EA0F721D231FDD3A0A17B9AC7808B4DD62C41256.asc \
      | gpg --dearmor --yes -o /etc/apt/keyrings/deb.griffo.io.gpg; \
    echo 'deb [signed-by=/etc/apt/keyrings/deb.griffo.io.gpg] https://deb.griffo.io/apt noble main' \
      > /etc/apt/sources.list.d/deb.griffo.io.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends yazi; \
    rm -rf /var/lib/apt/lists/*

USER vscode
RUN printf '\n# mise (per-project toolchains)\neval "$(mise activate zsh)"\n' >> /home/vscode/.zshrc \
 && printf '\n# mise (per-project toolchains)\neval "$(mise activate bash)"\n' >> /home/vscode/.bashrc

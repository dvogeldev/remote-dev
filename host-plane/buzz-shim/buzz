#!/usr/bin/env python3
# Hermes-buzz-plugin shim for `buzz` CLI (#48).
#
# The Hermes buzz plugin (plugins/platforms/buzz/adapter.py) shells out to a
# `buzz` CLI binary for two startup checks and outbound sends:
#
#   - buzz users get           — fetch our own profile (used by connect())
#   - buzz channels list       — list joined channels (used by connect())
#   - buzz messages get        — poll fallback (NOT used when BUZZ_TRANSPORT=websocket)
#   - buzz messages send ...   — outbound (Hermes -> Buzz); v0 inbound demo doesn't exercise this
#
# This shim implements the minimum surface needed to start the plugin and
# complete the inbound WS subscription path. Outbound sends fail with a
# JSON error matching the plugin's expected error contract:
#
#     {"error": "<category>", "message": "<detail>"}
#
# on stderr, exit code non-zero. The plugin handles the failure as a
# regular send error.
#
# Identity for `users get` comes from BUZZ_PRIVATE_KEY in the subprocess
# environment (the plugin sets it before exec).
#
# REPLACE WITH THE REAL `buzz-cli` (built from the block/buzz repo, crate
# `buzz-cli`) WHEN OUTBOUND IS NEEDED:
#
#     cargo install --git https://github.com/block/buzz --bin buzz-cli --locked
#     install -m 0755 ~/.cargo/bin/buzz-cli /usr/local/bin/buzz
#
# The shim can then be uninstalled (`rm /usr/local/bin/buzz`) and the real
# CLI takes over without further configuration (BUZZ_CLI_PATH defaults to
# PATH lookup).
import json
import os
import sys


def err(category, message, exit_code=2):
    """Emit a plugin-compatible error on stderr and exit non-zero."""
    json.dump({"error": category, "message": message}, sys.stderr)
    sys.stderr.write("\n")
    sys.exit(exit_code)


def derive_pubkey_hex(nsec_or_hex: str) -> str:
    """Return Hermes's xonly pubkey hex for the `users get` response.

    The plugin uses the pubkey for self-echo suppression and identity
    display. Without secp256k1 in this shim we can't derive the pubkey
    from the secret key, so we read it from the chezmoi mirror at
    ~/.hermes/nostr.npub (laid down per ADR #0010). If the mirror is
    missing, we fall back to deriving from the secret key bytes via a
    well-known hash shortcut — but the plugin will treat Hermes's own
    replies as external events (no self-echo). Inbound still works.

    Operators who need self-echo filter working should replace this shim
    with the real `buzz-cli`.
    """
    npub_file = os.path.expanduser("~/.hermes/nostr.npub")
    if os.path.exists(npub_file):
        try:
            with open(npub_file) as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("npub1"):
                        return _bech32_npub_to_hex(line)
        except OSError:
            pass
    # Fallback: return the secret key bytes themselves — the plugin will
    # treat Hermes's own replies as external events (no self-echo filter)
    # but inbound still works.
    return _secret_bytes_hex(nsec_or_hex)


def _bech32_npub_to_hex(npub: str) -> str:
    """Decode a Nostr npub bech32 string to its 32-byte xonly pubkey hex."""
    CHARSET = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
    body = npub[5:]  # strip "npub1"
    data = [CHARSET.index(c) for c in body if c in CHARSET]
    if len(data) < 6:
        err("invalid_npub", "npub too short")
    data = data[:-6]  # drop 6-char checksum
    acc, bits, out = 0, 0, bytearray()
    for v in data:
        acc = (acc << 5) | v
        bits += 5
        if bits >= 8:
            bits -= 8
            out.append((acc >> bits) & 0xFF)
    if len(out) != 32:
        err("invalid_npub", f"decoded {len(out)} bytes, expected 32")
    return out.hex()


def _secret_bytes_hex(nsec_or_hex: str) -> str:
    """Best-effort: return the secret-key bytes as hex (NOT a real pubkey)."""
    s = nsec_or_hex.strip()
    if s.startswith("nsec1"):
        CHARSET = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
        body = s[5:]
        data = [CHARSET.index(c) for c in body if c in CHARSET]
        if len(data) < 6:
            err("invalid_key", "nsec too short")
        data = data[:-6]
        acc, bits, out = 0, 0, bytearray()
        for v in data:
            acc = (acc << 5) | v
            bits += 5
            if bits >= 8:
                bits -= 8
                out.append((acc >> bits) & 0xFF)
        return out.hex()
    if len(s) == 64 and all(c in "0123456789abcdefABCDEF" for c in s):
        return s.lower()
    err("invalid_key", f"unrecognised BUZZ_PRIVATE_KEY format (len={len(s)})")


def sub_users(args: list[str]) -> int:
    nsec = os.environ.get("BUZZ_PRIVATE_KEY", "")
    profile = {
        "pubkey": derive_pubkey_hex(nsec),
        "display_name": "Hermes",
        "about": "",
        "nip05": "",
        "picture": "",
    }
    json.dump([profile], sys.stdout)
    sys.stdout.write("\n")
    return 0


def sub_channels(args: list[str]) -> int:
    json.dump([], sys.stdout)
    sys.stdout.write("\n")
    return 0


def sub_messages(args: list[str]) -> int:
    # v0 runs with BUZZ_TRANSPORT=websocket, so this poll-fallback path is
    # rarely hit. Return empty.
    json.dump([], sys.stdout)
    sys.stdout.write("\n")
    return 0


def sub_dms(args: list[str]) -> int:
    json.dump([], sys.stdout)
    sys.stdout.write("\n")
    return 0


def sub_version(args: list[str]) -> int:
    print("buzz-shim 0.1.0 (Hermes inbound demo — replace with real buzz-cli for outbound)")
    return 0


SUBCMDS = {
    "users": sub_users,
    "channels": sub_channels,
    "messages": sub_messages,
    "dms": sub_dms,
    "version": sub_version,
}


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        err("usage", "expected a subcommand: users, channels, messages, dms, version")
    sub = argv[0]
    if sub not in SUBCMDS:
        err("unknown_subcommand", f"unsupported subcommand: {sub}", exit_code=2)
    if sub != "version" and not os.environ.get("BUZZ_PRIVATE_KEY", ""):
        err("config_missing", "BUZZ_PRIVATE_KEY not set in environment")
    return SUBCMDS[sub](argv[1:])


if __name__ == "__main__":
    sys.exit(main())
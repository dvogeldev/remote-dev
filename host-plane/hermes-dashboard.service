[Unit]
Description=Hermes dashboard (browser UI for managing Hermes Agent)
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard
After=network.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Browser Origin is https://hermes.dvogeldev.com; without public_url the Chat
# PTY websocket is refused as origin_mismatch (WS close 1006). Declaring the
# public URL also engages Hermes' auth gate on a loopback bind — CF Access is
# still the public gate; basic auth (from ~/.hermes/.env) is the in-process
# provider Hermes requires. See servers/hermes-dvogeldev-access.md.
Environment=HERMES_DASHBOARD_PUBLIC_URL=https://hermes.dvogeldev.com
EnvironmentFile=-%h/.hermes/.env
ExecStart=%h/.local/bin/hermes dashboard --host 127.0.0.1 --port 9119 --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target